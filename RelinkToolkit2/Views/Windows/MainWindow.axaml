<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:RelinkToolkit2.Views"
        xmlns:dialogs="using:AvaloniaDialogs.Views"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="RelinkToolkit2.Views.Windows.MainWindow"
        Icon="/Assets/avalonia-logo.ico"
        Title="RelinkToolkit2"
		TransparencyLevelHint="AcrylicBlur"
		WindowState="Maximized"
		FontFamily="Segoe UI">
    <dialogs:ReactiveDialogHost CloseOnClickAway="True">
        <Grid>
	        <views:MainView />
            <dialogs:Snackbar Name="Snackbar" />
        </Grid>
    </dialogs:ReactiveDialogHost>
</Window>
