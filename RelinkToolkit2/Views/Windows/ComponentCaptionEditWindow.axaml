<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="400"
        xmlns:vm="using:RelinkToolkit2.ViewModels.Windows"
        x:Class="RelinkToolkit2.Views.Windows.ComponentCaptionEditWindow"
        x:DataType="vm:ComponentCaptionEditViewModel"
        xmlns:converters="using:RelinkToolkit2.Converters"
        xmlns:controls="using:RelinkToolkit2.Controls"
        Title="Component Caption Edit Window"
        Icon="/Assets/avalonia-logo.ico"
        Width="900" Height="400"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">
    <Window.DataContext>
		<vm:ComponentCaptionEditViewModel/>
	</Window.DataContext>

    <Window.Resources>
		<converters:VectorIconConverter x:Key="vectorIconConverter"/>
	</Window.Resources>

  <Grid RowDefinitions="Auto,*,Auto" >
      <TextBlock Grid.Row="0" Margin="6,4,0,0" FontWeight="Bold" Text="{Binding Key}"/>
      <Grid Grid.Row="1" ColumnDefinitions="*,6,*">
        <GroupBox Grid.Column="0" Margin="2" Header="Input (SmartFormat supported)" BorderThickness="0"> <!-- Note: GroupBox borders are bugged and the bottom keeps getting trimmed, so erase it -->
		  <TextBox Name="InputTextBox" Text="{Binding Value}" AcceptsReturn="True" PlaceholderText="Enter any text here"/>
        </GroupBox>
        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"/>
        <GroupBox Grid.Column="2" Margin="2" Header="Preview" BorderThickness="0">
          <Border BorderThickness="1" BorderBrush="{Binding #InputTextBox.BorderBrush}"> <!-- Quickly reuse the same border as the textbox -->
		      <TextBlock Text="{Binding PreviewString}" />
          </Border>
        </GroupBox>
      </Grid>
      <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto,Auto">
          <HyperlinkButton Grid.Row="0" Margin="4" NavigateUri="https://github.com/axuno/SmartFormat/wiki/Syntax%2C-Terminology">
              <StackPanel Orientation="Horizontal" Spacing="8">
                  <Image Width="14" Height="14">
	                   <Image.Source>
	                       <controls:VectorIconDrawingImage Drawing="{DynamicResource Material.Link}"/>
	                   </Image.Source>
	               </Image>
                  <TextBlock Text="SmartFormat Documentation" />
              </StackPanel>
          </HyperlinkButton>
          <Button Grid.Column="2" Width="100" Margin="4" Content="Cancel" Command="{Binding CancelCommand}"/>
		  <Button Grid.Column="3" Width="100" Margin="4" Content="Save" Command="{Binding SaveCommand}"/>
      </Grid>
  </Grid>
</Window>
