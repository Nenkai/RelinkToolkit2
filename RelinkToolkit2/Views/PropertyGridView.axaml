<UserControl x:Class="RelinkToolkit2.Views.PropertyGridView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:RelinkToolkit2"
			 xmlns:converters="using:RelinkToolkit2.Converters"
			 xmlns:controls="using:RelinkToolkit2.Controls"
			 xmlns:VMs="using:RelinkToolkit2.ViewModels"
             xmlns:fsmVMs="using:RelinkToolkit2.ViewModels.Fsm"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:pgc="using:Avalonia.PropertyGrid.Controls"
			 xmlns:ll="using:Avalonia.PropertyGrid.Localization"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="350"
			 x:DataType="VMs:PropertyGridViewModel"
			 xmlns:avalonia_propertygrid_controls="using:Avalonia.PropertyGrid.Controls"
			 xmlns:avalonia_controls="using:Avalonia.Controls"
			 xmlns:design="clr-namespace:RelinkToolkit2"
			 Name="MainPropertyGrid">
   	<Design.DataContext>
		 <x:Static Member="design:DesignData.PropertyGridViewModel" />
	</Design.DataContext>

	<UserControl.Resources>
		<converters:VectorIconConverter x:Key="vectorIconConverter"/>
	</UserControl.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="*"></RowDefinition>
			<RowDefinition Height="4"></RowDefinition>
			<RowDefinition MinHeight="70" Height="70"></RowDefinition>
		</Grid.RowDefinitions>
		<pgc:PropertyGrid Grid.Row="0"
			x:Name="propertyGrid_Basic"
			Margin="4"
			IsQuickFilterVisible="False"
			IsTitleVisible="False"
			IsAutoNameWidth="True"
			DataContext="{Binding SelectedObject}"
			PropertyCategorizingStyle="CategorizeByObjectInheritingOrder"
			CustomNameBlock="PropertyGrid_CustomNameBlock">
			<pgc:PropertyGrid.Styles>
				<Style>
					<Setter Property="(Interaction.Behaviors)">
							<BehaviorCollectionTemplate>
								<BehaviorCollection>
									<EventTriggerBehavior EventName="PropertyGotFocus">
										<InvokeCommandAction Command="{Binding #MainPropertyGrid.((VMs:PropertyGridViewModel)DataContext).PropertyGotFocusCommand}" PassEventArgsToCommand="True"/>
									</EventTriggerBehavior>
									<EventTriggerBehavior EventName="PropertyLostFocus">
										<InvokeCommandAction Command="{Binding #MainPropertyGrid.((VMs:PropertyGridViewModel)DataContext).PropertyLostFocusCommand}" PassEventArgsToCommand="True"/>
									</EventTriggerBehavior>
								</BehaviorCollection>
							</BehaviorCollectionTemplate>
						</Setter>
					</Style>
			</pgc:PropertyGrid.Styles>
		</pgc:PropertyGrid>
		<!-- TODO: Use PropertyGrid.BottomContent -->
		<GridSplitter Grid.Row="1"/>
		<Grid Grid.Row="2">
			<StackPanel>
				<Label Margin="4,0,0,0" FontSize="13" FontWeight="Bold" Content="{Binding ObjectName}"/>
				<TextBlock Margin="7,0,0,0" Text="{Binding Description}" TextWrapping="Wrap"/>
			</StackPanel>
		</Grid>
	</Grid>

</UserControl>
