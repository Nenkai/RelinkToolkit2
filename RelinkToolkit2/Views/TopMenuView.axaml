<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:VMs="using:RelinkToolkit2.ViewModels"
			 x:Class="RelinkToolkit2.Views.TopMenuView"
			 xmlns:converters="using:RelinkToolkit2.Converters"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="200"
             x:DataType="VMs:TopMenuViewModel">
	<Design.DataContext>
		<VMs:TopMenuViewModel />
	</Design.DataContext>

	<UserControl.Resources>
		<converters:VectorIconConverter x:Key="vectorIconConverter"/>
	</UserControl.Resources>

	<Menu ItemsSource="{Binding MenuItems}" ItemContainerTheme="{StaticResource MenuItemViewModelTopLevelTheme}">

	</Menu>
</UserControl>
