<UserControl x:Class="RelinkToolkit2.Controls.PropertyGrid.Views.DocumentablePropertyGridView"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:converters="using:RelinkToolkit2.Converters"
			 xmlns:VMs="using:RelinkToolkit2.Controls.PropertyGrid.ViewModel"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:pgc="using:Avalonia.PropertyGrid.Controls"
			 xmlns:md="https://github.com/whistyun/Markdown.Avalonia"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="350"
			 x:DataType="VMs:DocumentablePropertyGridViewModel"
			 xmlns:design="clr-namespace:RelinkToolkit2"
			 Name="MainPropertyGrid">
   	<Design.DataContext>
		 <x:Static Member="design:DesignData.DocumentablePropertyGridViewModel" />
	</Design.DataContext>

	<UserControl.Resources>
		<converters:VectorIconConverter x:Key="vectorIconConverter"/>
		<converters:BoolToGridLengthConverter x:Key="boolToGridLengthConverter"/>
    <converters:BoolToDoubleConverter x:Key="boolToDoubleConverter"/>
	</UserControl.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="*"></RowDefinition>
			<RowDefinition Height="{Binding #MainPropertyGrid.DocumentationPanelVisible, Converter={StaticResource boolToGridLengthConverter}, ConverterParameter=4}"/>
			<RowDefinition Height="{Binding #MainPropertyGrid.DocumentationPanelVisible, Converter={StaticResource boolToGridLengthConverter}, ConverterParameter=120}"
						   MinHeight="{Binding #MainPropertyGrid.DocumentationPanelVisible, Converter={StaticResource boolToDoubleConverter}, ConverterParameter=70}"/>
		</Grid.RowDefinitions>
		<pgc:PropertyGrid Grid.Row="0"
			x:Name="propertyGrid_Basic"
			IsQuickFilterVisible="{Binding #MainPropertyGrid.IsQuickFilterVisible}"
			IsHeaderVisible="{Binding #MainPropertyGrid.IsHeaderVisible}"
			IsCategoryVisible="{Binding #MainPropertyGrid.IsCategoryVisible}"
			LayoutStyle="{Binding #MainPropertyGrid.LayoutStyle}"
			IsTitleVisible="{Binding #MainPropertyGrid.IsTitleVisible}"
			IsAutoNameWidth="True"
			IsReadOnly="{Binding #MainPropertyGrid.((VMs:DocumentablePropertyGridViewModel)DataContext).ReadOnly}"
			DataContext="{Binding SelectedObject}"
			PropertyCategorizingStyle="{Binding #MainPropertyGrid.PropertyCategorizingStyle}"
			CustomNameBlock="PropertyGrid_CustomNameBlock">
			<pgc:PropertyGrid.Styles>
				<Style>
					<Setter Property="(Interaction.Behaviors)">
							<BehaviorCollectionTemplate>
								<BehaviorCollection>
									<EventTriggerBehavior EventName="PropertyGotFocus">
										<InvokeCommandAction Command="{Binding #MainPropertyGrid.((VMs:DocumentablePropertyGridViewModel)DataContext).PropertyGotFocusCommand}" PassEventArgsToCommand="True"/>
									</EventTriggerBehavior>
									<EventTriggerBehavior EventName="PropertyLostFocus">
										<InvokeCommandAction Command="{Binding #MainPropertyGrid.((VMs:DocumentablePropertyGridViewModel)DataContext).PropertyLostFocusCommand}" PassEventArgsToCommand="True"/>
									</EventTriggerBehavior>
								</BehaviorCollection>
							</BehaviorCollectionTemplate>
						</Setter>
					</Style>
			</pgc:PropertyGrid.Styles>
		</pgc:PropertyGrid>
		<!-- TODO: Use PropertyGrid.BottomContent -->
		<GridSplitter Grid.Row="1" IsVisible="{Binding #MainPropertyGrid.DocumentationPanelVisible}"/>
		<md:MarkdownScrollViewer Grid.Row="2" DockPanel.Dock="Bottom" Markdown="{Binding Description}" IsVisible="{Binding #MainPropertyGrid.DocumentationPanelVisible}"/>
	</Grid>

</UserControl>
